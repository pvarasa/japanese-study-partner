# Copy to .env and fill in your values.

# Required: Anthropic API key for Claude-powered features.
ANTHROPIC_API_KEY=

# Optional: local Whisper (faster-whisper) for audio transcription.
# Default is a Japanese-fine-tuned Kotoba-Whisper (best quality for JP).
# Alternatives: large-v3-turbo (multilingual, fast), large-v3, medium, small
WHISPER_MODEL=kotoba-tech/kotoba-whisper-v2.0-faster

# Device: "auto" (prefers CUDA if available), "cuda", or "cpu"
WHISPER_DEVICE=auto

# Compute type: "auto", "float16" (recommended for CUDA), "int8_float16",
# "int8" (CPU), "float32"
WHISPER_COMPUTE_TYPE=auto
