# Copy to .env and fill in your values.

# Required: Anthropic API key for Claude-powered features.
ANTHROPIC_API_KEY=

# Database URL. Leave unset to use local SQLite (nihongo.db). Set to a
# PostgreSQL connection string for Docker/K8s deployments.
# Example: postgresql+psycopg2://user:password@host/dbname
DATABASE_URL=

# Set to "false" to disable speech-to-text entirely (e.g. in Docker/K8s where
# the 1.5 GB model weight download is undesirable). Mic controls are hidden in
# the UI when disabled. Default: true.
WHISPER_ENABLED=true

# Optional: local Whisper (faster-whisper) for audio transcription.
# Default is a Japanese-fine-tuned Kotoba-Whisper (best quality for JP).
# Alternatives: large-v3-turbo (multilingual, fast), large-v3, medium, small
WHISPER_MODEL=kotoba-tech/kotoba-whisper-v2.0-faster

# Device: "auto" (prefers CUDA if available), "cuda", or "cpu"
WHISPER_DEVICE=auto

# Compute type: "auto", "float16" (recommended for CUDA), "int8_float16",
# "int8" (CPU), "float32"
WHISPER_COMPUTE_TYPE=auto

# Provider for word/phrase translation lookups (/api/furigana/lookup).
# "anthropic" (default) calls Claude. "ollama" calls a local Ollama server.
TRANSLATION_PROVIDER=anthropic

# Ollama server URL. From WSL with Ollama running on the Windows host with
# "Expose to network" enabled, "http://host.docker.internal:11434" works.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama model tag to use. qwen2.5:7b is a strong, compact JP↔EN choice.
OLLAMA_TRANSLATION_MODEL=qwen2.5:7b
